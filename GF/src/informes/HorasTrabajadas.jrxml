	<queryString language="SQL">
		<![CDATA[SELECT PERSONAL.id_personal, PERSONAL.NOMBRE, PERSONAL.APELLIDOS, categoria.nombre AS CATEGORIA, SUM(TIMESTAMPDIFF(HOUR, FICHAJE.fecha_inicial, FICHAJE.fecha_final)) AS total_horas FROM PERSONAL INNER JOIN FICHAJE ON PERSONAL.id_personal = FICHAJE.id_personal INNER JOIN categoria on personal.id_categoria = categoria.id_categoria where fichaje.accion = "Trabajo" GROUP BY PERSONAL.id_personal, PERSONAL.NOMBRE, PERSONAL.APELLIDOS;]]>
	</queryString>
