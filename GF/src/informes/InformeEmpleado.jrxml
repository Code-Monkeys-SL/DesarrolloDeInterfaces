	<parameter name="idPersonal" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT personal.nombre, personal.apellidos, fichaje.accion, fichaje.fecha_inicial, fichaje.fecha_final, TIMESTAMPDIFF(HOUR, FICHAJE.fecha_inicial, FICHAJE.fecha_final) AS Diferencia from personal INNER join fichaje on personal.id_personal = fichaje.id_personal where fichaje.id_personal = $P{idPersonal};]]>
	</queryString>
